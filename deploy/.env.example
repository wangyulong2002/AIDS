# =============================================================
# AIDS 开发环境变量模板
#
# 使用: cp .env.example .env  然后按需修改
# 【安全】.env 不得提交到版本库（已在 .gitignore 中排除）
# =============================================================

# ---------- 端口（本机端口冲突时改这里）----------
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=29092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
MILVUS_MINIO_PORT=9100

# ---------- 中间件密码（开发环境默认值，生产必须更换）----------
MYSQL_ROOT_PASSWORD=aids_root_2026
REDIS_PASSWORD=aids_redis_2026
MINIO_USER=aids_minio
MINIO_PASSWORD=aids_minio_2026

# ---------- 应用配置（后端/FastAPI 读取）----------

# 数据源
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aids_shop
DB_USER=root
DB_PASSWORD=aids_root_2026

# Redis（REDIS_PORT / REDIS_PASSWORD 复用上面「端口」段与「中间件密码」段的定义，
# 此处只补充应用侧的连接地址；同名键不要重复定义，后者会静默覆盖前者）
REDIS_HOST=localhost

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Milvus 向量库（需 --profile search；商品搜索走 MySQL 全文索引，不用向量库，见 PRD §5.6）
# 端口复用上方「端口」段的 MILVUS_PORT（compose 用它发布宿主端口，应用也连这个宿主端口），
# 此处不要重复定义 —— 同名键在 .env 里后者会静默覆盖前者。
MILVUS_HOST=localhost

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=aids_minio
MINIO_SECRET_KEY=aids_minio_2026
MINIO_BUCKET_PRODUCT=aids-product
MINIO_BUCKET_REVIEW=aids-review
MINIO_BUCKET_REFUND=aids-refund
MINIO_BUCKET_KB=aids-kb

# ---------- 敏感密钥（生产必须重新生成，禁止使用此处默认值）----------

# JWT 签名密钥（RS256 私钥路径；公钥经 JWKS 端点分发，供 AI 服务验签）
JWT_PRIVATE_KEY_PATH=./config/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./config/jwt_public.pem
JWT_ACCESS_EXPIRE_SECONDS=7200
JWT_REFRESH_EXPIRE_SECONDS=604800

# 手机号 AES-256-GCM 加密密钥（32 字节 hex = 64 字符）
# 生成: openssl rand -hex 32
MOBILE_AES_KEY=a1d7f3c9e5b2048168cafe11d3b7e94f5a2c8d610e3b47f9a0c5d2e8b4f16a73

# 手机号 HMAC-SHA256 密钥（用于查询与唯一约束，必须带密钥防彩虹表）
# 生成: openssl rand -hex 32
MOBILE_HMAC_KEY=3f8a1c6e9d24b7058af3e1c07d6b92548e0f3a7c1d5b84629e7f0a3c8d1b5e46

# 服务间调用鉴权（主业务 ↔ AI 服务）
INTERNAL_TOKEN=aids_internal_token_2026
INTERNAL_SIGN_KEY=aids_internal_sign_key_2026

# ---------- AI 服务（真实接入，按量计费）----------

# 火山引擎方舟 API Key —— 从环境变量注入，禁止写入代码或前端
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-pro-32k
ARK_EMBEDDING_MODEL=doubao-embedding
ARK_EMBEDDING_DIM=2048

# 日预算上限保护（超出后降级为 FAQ 检索，不再调用 LLM）
ARK_DAILY_BUDGET_TOKENS=2000000

# ---------- Mock 服务（模拟第三方渠道）----------
MOCK_PAYMENT_BASE_URL=http://localhost:8081
MOCK_PAYMENT_MERCHANT_ID=aids_merchant_001
# RSA2 商户私钥/渠道公钥（Mock 环境用自签密钥对）
MOCK_PAYMENT_PRIVATE_KEY_PATH=./config/mock_pay_private.pem
MOCK_PAYMENT_PUBLIC_KEY_PATH=./config/mock_pay_public.pem

# 故障注入开关（供 PRD §12.3/§12.6 验收用例使用）
MOCK_CALLBACK_DELAY_SECONDS=0
MOCK_CALLBACK_REPEAT_TIMES=1
MOCK_CALLBACK_LOSS_RATE=0
MOCK_CHANNEL_FAILURE_RATE=0
