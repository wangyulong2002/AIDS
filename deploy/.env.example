# =============================================================
# AIDS 开发环境变量模板（编排层）
#
# 使用: cp .env.example .env  然后按需修改
# 【安全】.env 不得提交到版本库（已在 .gitignore 中排除）
#
# 【分工】
#   上半部分 = 编排专属（compose 的 ${VAR} 引用，Docker 官方镜像约定）
#   下半部分 = 应用变量，**键名以仓库根 .env.example 为准**（同名同键）
#
#   check_env_hygiene() 强制：根 .env.example 的每个键都必须在这里出现。
#   历史教训：两侧各叫一套（JWT_ACCESS_TTL vs JWT_ACCESS_EXPIRE_SECONDS、
#   FIELD_ENCRYPT_KEY vs MOBILE_AES_KEY …），会让「按本文件起服务」在
#   production 因 S1-c 缺必需 Key 直接启动失败（§9.6）。
# =============================================================

# ---------- 编排专属：端口（本机端口冲突时改这里）----------
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=29092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_WEB_PORT=9091
MILVUS_MINIO_PORT=9100

# ---------- 编排专属：中间件凭据（开发默认值，生产必须更换）----------
MYSQL_ROOT_PASSWORD=aids_root_2026
REDIS_PASSWORD=aids_redis_2026
MINIO_USER=aids_minio
MINIO_PASSWORD=aids_minio_2026

# =============================================================
# 以下与应用侧（根 .env.example）同名同义。
# 改命名请先改根文件，再同步这里 —— 否则 CI 的文档一致性门禁会红。
# =============================================================

APP_ENV=development

# 数据源（应用侧统一用完整连接串，不再拆 DB_HOST/DB_PORT/...）
DATABASE_URL=mysql+asyncmy://root:aids_root_2026@127.0.0.1:3306/aids_shop?charset=utf8mb4

# Redis（应用侧统一用完整连接串；密码与上面 REDIS_PASSWORD 保持一致）
REDIS_URL=redis://:aids_redis_2026@127.0.0.1:6379/0

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092

# SECRET_KEY 是 S1-b 的硬校验项，编排层缺它 = production 起不来
SECRET_KEY=dev-only-change-me-in-production-32chars+
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800
JWT_PRIVATE_KEY_PATH=./config/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./config/jwt_public.pem

# 手机号 AES-256-GCM / HMAC-SHA256 密钥（生成：openssl rand -hex 32）
FIELD_ENCRYPT_KEY=a1d7f3c9e5b2048168cafe11d3b7e94f5a2c8d610e3b47f9a0c5d2e8b4f16a73
FIELD_HMAC_KEY=3f8a1c6e9d24b7058af3e1c07d6b92548e0f3a7c1d5b84629e7f0a3c8d1b5e46

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k
ARK_EMBEDDING_MODEL=doubao-embedding
ARK_EMBEDDING_DIM=2048
ARK_DAILY_BUDGET_TOKENS=2000000

# Milvus（需 --profile search；商品搜索走 MySQL 全文索引，不用向量库，见 PRD §5.6）
# MILVUS_PORT 是「编排 + 应用」共用变量：compose 用 ${MILVUS_PORT} 发布宿主端口，
# 应用也连这个宿主端口，故全局只定义这一处。
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=aids_kb

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=aids_minio
MINIO_SECRET_KEY=aids_minio_2026
MINIO_BUCKET_PRODUCT=aids-product
MINIO_BUCKET_REVIEW=aids-review
MINIO_BUCKET_REFUND=aids-refund
MINIO_BUCKET_KB=aids-kb

INTERNAL_SERVICE_TOKEN=aids_internal_token_2026
INTERNAL_SIGN_SECRET=aids_internal_sign_key_2026

MOCK_PAY_BASE_URL=http://127.0.0.1:18081
MOCK_PAY_MERCHANT_ID=MOCK_MERCHANT_001
MOCK_PAY_RSA_PRIVATE_KEY_PATH=./config/mock_pay_private.pem
MOCK_PAY_RSA_PUBLIC_KEY_PATH=./config/mock_pay_public.pem
MOCK_CALLBACK_DELAY_SECONDS=0
MOCK_CALLBACK_REPEAT_TIMES=1
MOCK_CALLBACK_LOSS_RATE=0
MOCK_CHANNEL_FAILURE_RATE=0
