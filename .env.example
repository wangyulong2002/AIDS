# =============================================================
# AIDS 主业务服务 —— 环境变量模板
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除。
# =============================================================

# ---- 运行环境：development / test / staging / production ----
# 启动断言（app/core/config.py）会依据该值执行硬校验：
#   - production：禁止连含 test/dev 字样的库；SECRET_KEY 不得为默认值；必需 Key 必须存在
#   - test/development：禁止连生产库名 aids_shop
APP_ENV=development

# ---- 主业务库 ----
# 注意：时间统一 UTC。连接串须含 connectionTimeZone=UTC 或连接后 SET time_zone='+00:00'
DATABASE_URL=mysql+asyncmy://aids:aids_pass@127.0.0.1:13306/aids_shop?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:16379/0

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092

# ---- JWT（RS256 + JWKS，TASKS BE-03）----
SECRET_KEY=dev-only-change-me-in-production-32chars+
JWT_ACCESS_TTL=7200        # 2h
JWT_REFRESH_TTL=604800     # 7d
# RS256 私钥路径（私钥不入库，由环境注入）；公钥经 JWKS 端点暴露供 AI 服务验签
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# ---- 敏感字段加密（schema.sql 头部约定 9）----
# 手机号 AES-256-GCM 加密 + HMAC-SHA256 哈希（禁止裸 SHA-256，可被彩虹表反查）
FIELD_ENCRYPT_KEY=dev-only-32-byte-key-please-change
FIELD_HMAC_KEY=dev-only-hmac-key-please-change

# ---- AI 服务（Ark）----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ark-code-latest

# ---- Milvus（RAG 向量库）----
# 注意：REST 与 gRPC 同端口 19530；9091 仅 /healthz 与 /metrics
# 集合必须显式 load，否则 search 静默返回空数组且不报错（PRD §9.2）
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=aids_kb

# ---- MinIO（对象存储）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aids

# ---- 内部服务鉴权（TASKS BE-06）----
INTERNAL_SERVICE_TOKEN=dev-internal-token
INTERNAL_SIGN_SECRET=dev-internal-sign-secret

# ---- Mock 渠道 ----
MOCK_PAY_BASE_URL=http://127.0.0.1:18081
MOCK_PAY_MERCHANT_ID=MOCK_MERCHANT_001
MOCK_PAY_RSA_PRIVATE_KEY_PATH=./secrets/mock_pay_private.pem
