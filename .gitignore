.mypy_cache/
.ruff_cache/
# hypothesis 会在 .hypothesis/ 内自动生成 .gitignore（内容为 *）而自忽略；
# 这里显式写一行，避免读者以为漏了规则。
.hypothesis/
.coverage
htmlcov/
coverage.xml

# ---- 环境变量与密钥（S7 结构性防御）----
.env
.env.*
!.env.example
deploy/.env
*.pem
*.key
!deploy/nginx/*.key.example

# ---- 本地方案/数据（S7）----
*.db
*.sqlite3
*.sql.gz
_backup_*/
uploads/
data/
logs/
*.log

# ---- 修复产物备份（防误提交）----
docs/_P0修复产物/_backup_*/

# ---- AI 工作目录（WorkBuddy）----
# memory/ 是 AI 每次工作都会追加写入的日志 —— 入库会让每次对话都产生一个待提交
# 变更（实测发生过）。HANDOFF.md 是项目交接文档，**有意保留入库**，
# 故此处只忽略 memory/，而不是整个 .workbuddy/。
.workbuddy/memory/

# ---- AI 工作目录（CodeBuddy）----
# .codebuddy/skills/ 是从 mattpocock/skills 下载后做本地适配得到的技能库，
# 属于开发者个人环境配置而非项目代码；不同开发者的技能集合与版本可能不同，
# 入库只会带来无意义的 diff，故整体忽略，而不是逐个子目录挑拣。
.codebuddy/

# ---- IDE ----
.idea/
.vscode/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Node（前端工程）----
node_modules/
web/**/dist/
admin/**/dist/
# 本仓库实际的前端工程目录是 aids-mall / aids-admin（与
# deploy/app/frontend.Dockerfile 的 APP_DIR 参数一致）。上面 web/ 与 admin/ 是
# 历史占位，保留以免误伤旧分支；新增前端工程时**两处都要补**。
aids-mall/dist/
aids-admin/dist/
# Vite / Vitest 加载 TS 配置时会生成 `.timestamp-*.mjs` 临时文件
# （正常退出自行删除，进程被强杀时残留）；它是纯中间产物，不入库。
*.timestamp-*.mjs

# ---- 临时/探针文件 ----
# 与 scripts/hooks/forbid_temp_files.sh 互为双保险。
#
# ★ 这里**刻意不使用**宽泛的 `_*` / `*/_*.py` / `app/_*` 形态：
#   它们会连 `__init__.py`（包标识，必须以 `_` 开头）一起忽略。
#   历史教训：`*/_*.py` 让 `app/__init__.py` 长期进不了版本库，
#   而"少了一个 __init__.py"没有任何测试会发现（import 照样成功）。
#   同理 `_doc_parser.py`（契约测试的公共解析器，命名以 `_` 开头是刻意的）
#   也会被这类规则误伤。
# 因此：**按具体残留形态收口**；宽泛拦截交给 forbid_temp_files.sh（它有显式白名单），
# 并由 tests/invariants/test_guard_selfcheck.py 断言"受跟踪文件不被任何忽略规则命中"。
**/_probe*.py
**/_tmp*.py
**/_scan_*.py
**/_wtest*
*.bak
*.orig
*.rej
*~
*.tmp

# ---- 工具探针输出（根目录，pyright/临时脚本）----
_*.json
_*.txt
